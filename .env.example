# Qwen-Agent / DashScope（可选文案精修、桌面助手）
DASHSCOPE_API_KEY=

# 高德地图 MCP（amap-maps）—— 规划路线 / 天气 / POI 必需
AMAP_MAPS_API_KEY=

# Tavily 网络搜索 MCP（配图检索，可选；不填则跳过配图）
TAVILY_API_KEY=

# 可选：按 IP 的每日配额（默认 40 次规划 / 80 次改路）
# ROADBOOK_PLAN_DAILY=40
# ROADBOOK_CHAT_DAILY=80

# 可选：后台 /admin 口令（不配则后台不可用）
ROADBOOK_ADMIN_PASSWORD=
